{
  "manifest_version": 3,
  "name": "Desbloqueio Inteligente Sync",
  "description": "Sincroniza questões do Google Sheets com o protótipo Desbloqueio Inteligente.",
  "version": "0.1.0",
  "action": {
    "default_title": "Sincronizar questões",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ]
}
